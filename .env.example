# Reminders (web push). Generate keys once with:  pnpm dlx web-push generate-vapid-keys
# Copy this file to .env.local and fill it in. .env.local is gitignored; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if your server misbehaves, for example mailto:you@yourdomain.com
VAPID_SUBJECT=mailto:admin@example.com

# Optional
APP_TZ=America/Toronto
# Application uses Postgres; no SQLite fallback or automatic migrations/seeding.
# DATABASE_ENV=development
# DATABASE_URL=<POOLED_DEV_CONNECTION_URL>
# For remote dev/test, this must match the exact application URL host.
# DATABASE_NONPRODUCTION_HOST=POOLED_DEV_HOST
#
# Explicit release commands use a DIRECT URL, not the application pooler.
# CLI commands do not load .env.local automatically. Supply these via a trusted environment loader.
# Production and preview migrations are deliberately blocked for now.
# DATABASE_ENV=development
# DATABASE_URL_UNPOOLED=<DIRECT_DEV_CONNECTION_URL_FROM_NEON>
# Set this to the direct host for migration/seed commands (pooled/direct hosts differ).
# DATABASE_NONPRODUCTION_HOST=DIRECT_DEV_HOST
