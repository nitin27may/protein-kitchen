# Reminders (web push). Generate keys once with:  pnpm dlx web-push generate-vapid-keys
# Copy this file to .env.local and fill it in. .env.local is gitignored; never commit the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach if your server misbehaves, for example mailto:you@yourdomain.com
VAPID_SUBJECT=mailto:admin@example.com
# No timer or external cron is provisioned. Empty POST /api/reminders uses this separate bearer secret.
REMINDER_SCHEDULER_ENABLED=false
REMINDER_SCHEDULER_SECRET=
# Use a distinct random 32-128-character URL-safe secret, never an auth/state-sync/provider credential.

# Optional
APP_TZ=America/Toronto
# Contact address shown on /privacy. Required in production (plain Vercel variable); the owner supplies the value.
# PRIVACY_CONTACT_EMAIL=
# Library photo candidate review: off by default when VERCEL_ENV=production, on elsewhere. Must stay unset or false at launch.
# PHOTO_REVIEW_ENABLED=
# Local photos default to filesystem; Vercel refuses filesystem uploads.
# BLOB_STORE=neon
# BLOB_BUCKET=PRIVATE_BUCKET_NAME
# AWS_ENDPOINT_URL_S3=https://br-PRODUCTION_ID.storage.c-CELL.us-east-2.aws.neon.tech
# AWS_REGION=us-east-2
# Explicit branch-scoped storage credentials, server-only; never NEXT_PUBLIC_ variables.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Cloud endpoint must match NEON_PRODUCTION_BRANCH_ID. Local development uses the filesystem store.
# Bucket must be private; an owner-only ACL is checked before the first object operation.
# Private state sync is off unless explicitly enabled after owner consent.
# These server-only values must identify one dedicated, existing private non-fork repository/branch.
# No PAT fallback, repository creation, force push or production secrets in previews.
# STATE_SYNC_ENABLED=false
# Explicit, nonempty shared-class consent, e.g. recipe-links,saved-views.
# Never put personal/profile classes here. Shared notes/photos can still be sensitive.
STATE_SYNC_CLASSES=
# Server-only exact household id for this private target; never supplied by the browser.
STATE_SYNC_HOUSEHOLD_ID=
# Optional POST scheduler credential (32-128 URL-safe characters), distinct from auth/App secrets.
# No scheduler is provisioned automatically.
STATE_SYNC_SCHEDULER_SECRET=
# Local/approved-runner encrypted recovery only; no upload or schedule is enabled.
# Requires age and a compatible pg_dump on PATH (or explicit binary paths).
BACKUP_AGE_RECIPIENT=
BACKUP_OUTPUT_DIR=
AGE_BIN=
PG_DUMP_BIN=
# Local isolated recovery only; never reuse an application/source database URL.
RESTORE_DATABASE_URL=
PG_RESTORE_BIN=
# STATE_GITHUB_APP_ID=
# STATE_GITHUB_INSTALLATION_ID=
# STATE_GITHUB_REPOSITORY_ID=
# STATE_GITHUB_OWNER=
# STATE_GITHUB_REPOSITORY=
# STATE_GITHUB_BRANCH=
# STATE_GITHUB_PRIVATE_KEY=<PEM RSA private key from the owner-installed GitHub App>
# The transport requests a short-lived token for that repository only, with contents:write.
# Local development: a throwaway loopback Postgres (or PGlite in tests). Never point local env at Neon.
# Application uses Postgres; no SQLite fallback or automatic migrations/seeding.
# DATABASE_ENV=development
# DATABASE_URL=postgres://user@127.0.0.1:5432/protein_kitchen_dev
# Explicit CLI commands (migrate, seed) use a direct URL. CLI commands do not load .env.local.
# DATABASE_URL_UNPOOLED=postgres://user@127.0.0.1:5432/protein_kitchen_dev
#
# Production is configured only in Vercel Production (runtime) and the GitHub `production`
# environment (deploy job), never in this file. Names only, see docs/plan-v3-publish-and-protect.md:
#   Vercel sensitive: DATABASE_URL, BETTER_AUTH_SECRET, RESEND_API_KEY, AWS_ACCESS_KEY_ID,
#     AWS_SECRET_ACCESS_KEY, SIGNUP_ALLOWLIST
#   Vercel plain: DATABASE_ENV=production, DATABASE_PRODUCTION_HOST, NEON_PROJECT_ID,
#     NEON_PRODUCTION_BRANCH_ID, BETTER_AUTH_URL, AUTH_EMAIL_FROM, BLOB_STORE, BLOB_BUCKET,
#     AWS_ENDPOINT_URL_S3, AWS_REGION, APP_TZ, MAIL_DAILY_CAP, PRIVACY_CONTACT_EMAIL, and the *_ENABLED flags set false
#   GitHub production environment: DATABASE_URL, DATABASE_URL_UNPOOLED, NEON_API_KEY, VERCEL_TOKEN,
#     PRODUCTION_PROTECTION_BYPASS (secrets); VERCEL_ORG_ID, VERCEL_PROJECT_ID, NEON_PROJECT_ID,
#     NEON_PRODUCTION_BRANCH_ID, DATABASE_PRODUCTION_HOST, DATABASE_DIRECT_PRODUCTION_HOST,
#     PRODUCTION_ORIGIN, AUTH_EMAIL_FROM, NEON_DATABASE_NAME, NEON_ROLE_NAME (variables; the last two for the rehearsal)
# The CI migration rehearsal branch alone uses NEON_DEVELOPMENT_BRANCH_ID and SQLITE_IMPORT_NEON_BRANCH_ID.
# Browser regression tests use a separate disposable LOOPBACK database, never Neon or household data.
# POSTGRES_E2E_URL=postgres://fixture@127.0.0.1:5432/protein_kitchen_e2e

# Better Auth is server-only. New auth routes refuse requests until explicitly configured.
# BETTER_AUTH_URL=http://localhost:3000
# Generate a random value of at least 32 characters, different for every environment.
# BETTER_AUTH_SECRET=
# Local development only. Must be absent in production: signup is open and nothing is claimed by bootstrap.
# HOUSEHOLD_BOOTSTRAP_SECRET=
# Auth code delivery needs a verified Resend sending domain/address. No automatic test sender/fallback.
# RESEND_API_KEY=
# AUTH_EMAIL_FROM=auth@example.com

# Encrypted vault operator only: explicit dev/test runner, never Vercel/build/request.
# No defaults/fallback to state-sync credentials; use a separately approved private repository.
# VAULT_ENABLED=false
# VAULT_GITHUB_APP_ID=
# VAULT_GITHUB_INSTALLATION_ID=
# VAULT_GITHUB_REPOSITORY_ID=
# VAULT_GITHUB_OWNER=
# VAULT_GITHUB_REPOSITORY=
# VAULT_GITHUB_BRANCH=
# VAULT_GITHUB_PRIVATE_KEY=

# Auth mail protection (read by lib/auth/config.ts).
# Comma-separated signup addresses and/or whole domains (@example.com). Unset or blank means open signup.
# When set, an address with no account, not listed and with no pending household association is sent nothing and gets
# the same response as everyone else, and the sign-in page says sign-up is invite-only.
# SIGNUP_ALLOWLIST=
# Global auth mail cap per UTC day, a whole number from 1 to 99 (default 60; Resend's free tier allows 100).
# Per recipient the limits are fixed at 3 per 15 minutes and 10 per UTC day.
# MAIL_DAILY_CAP=
