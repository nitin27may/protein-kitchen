  "steps": [
    {
      "text": "Mix besan, chopped methi, dahi, ginger, chilli, turmeric and salt into a firm dough, adding a little water only if needed."
    },
    {
      "text": "Shape into two logs and steam for 15 minutes until a knife comes out clean.",
      "timer_sec": 900,
      "cue": "A knife pushed into the centre comes out clean and the surface springs back when pressed.",
