{
  "name": "protein-kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/validate.ts && tsx scripts/seed.ts",
    "backup": "tsx scripts/backup.ts",
    "backup:postgres": "tsx scripts/backup-postgres.ts",
    "photos:check": "tsx scripts/photos-check.ts",
    "photos:candidates": "tsx scripts/photo-candidates.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:postgres": "drizzle-kit generate --config=drizzle.postgres.config.ts",
    "db:migrate:postgres": "tsx scripts/migrate-postgres.ts",
    "db:verify:postgres": "tsx scripts/verify-postgres.ts",
    "db:import:sqlite": "tsx scripts/import-sqlite.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@better-auth/drizzle-adapter": "1.7.12",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "@univerjs/preset-sheets-core": "^1.2.0",
    "@univerjs/preset-sheets-filter": "^1.2.0",
    "@univerjs/preset-sheets-sort": "^1.2.0",
    "@univerjs/presets": "^1.2.0",
    "@vercel/functions": "^3.10.3",
    "better-auth": "1.7.12",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "gray-matter": "^4.0.3",
    "next": "^16.4.2",
    "pdfmake": "^0.3.12",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "exceljs>uuid": "^11.1.1"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
